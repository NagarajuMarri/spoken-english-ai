# Copy to .env.production in the deployment secret store. Never commit real values.
SPOKEN_ENGLISH_ENVIRONMENT=production
SPOKEN_ENGLISH_DEBUG=false
SPOKEN_ENGLISH_AUTO_CREATE_TABLES=false
SPOKEN_ENGLISH_DATABASE_URL=postgresql+psycopg://APP_USER:SECRET@POSTGRES_HOST:5432/spoken_english
SPOKEN_ENGLISH_DATABASE_POOL_SIZE=5
SPOKEN_ENGLISH_REDIS_URL=rediss://REDIS_HOST:6379/0
SPOKEN_ENGLISH_REDIS_REQUIRED=true
SPOKEN_ENGLISH_OBJECT_STORAGE_BACKEND=s3
SPOKEN_ENGLISH_OBJECT_STORAGE_BUCKET=PRIVATE_AUDIO_BUCKET
SPOKEN_ENGLISH_OBJECT_STORAGE_ENDPOINT=https://S3_COMPATIBLE_ENDPOINT
SPOKEN_ENGLISH_OBJECT_STORAGE_ACCESS_KEY=FROM_SECRET_STORE
SPOKEN_ENGLISH_OBJECT_STORAGE_SECRET_KEY=FROM_SECRET_STORE
SPOKEN_ENGLISH_JWT_ACTIVE_KEY_ID=active-key-id
SPOKEN_ENGLISH_JWT_VERIFICATION_KEYS_JSON={"active-key-id":"FROM_SECRET_STORE_AT_LEAST_32_BYTES"}
SPOKEN_ENGLISH_FORCE_HTTPS=true
SPOKEN_ENGLISH_SECURE_COOKIES=true
SPOKEN_ENGLISH_CORS_ORIGINS=https://staging.example.invalid
SPOKEN_ENGLISH_TRUSTED_HOSTS=staging.example.invalid
SPOKEN_ENGLISH_PUBLIC_FRONTEND_URL=https://staging.example.invalid
SPOKEN_ENGLISH_PUBLIC_API_URL=https://staging.example.invalid
SPOKEN_ENGLISH_LLM_PROVIDER=disabled
SPOKEN_ENGLISH_SPEECH_TO_TEXT_PROVIDER=disabled
SPOKEN_ENGLISH_TEXT_TO_SPEECH_PROVIDER=disabled
SPOKEN_ENGLISH_WORKER_ENABLED=true
SPOKEN_ENGLISH_BUILD_IDENTIFIER=SET_TO_COMMIT_SHA
BACKEND_IMAGE=registry.example.invalid/spoken-english/backend:SET_TO_COMMIT_SHA
FRONTEND_IMAGE=registry.example.invalid/spoken-english/frontend:SET_TO_COMMIT_SHA
