SPOKEN_ENGLISH_APP_NAME=spoken-english-ai
SPOKEN_ENGLISH_APP_VERSION=0.1.0
SPOKEN_ENGLISH_ENVIRONMENT=development
SPOKEN_ENGLISH_DEBUG=false
SPOKEN_ENGLISH_DATABASE_URL=sqlite:///./spoken_english_ai.db
SPOKEN_ENGLISH_LLM_PROVIDER=disabled
SPOKEN_ENGLISH_SPEECH_TO_TEXT_PROVIDER=disabled
SPOKEN_ENGLISH_TEXT_TO_SPEECH_PROVIDER=disabled
SPOKEN_ENGLISH_AUTO_CREATE_TABLES=true
SPOKEN_ENGLISH_TEMPORARY_AUDIO_EXPIRATION_HOURS=24
SPOKEN_ENGLISH_JWT_SECRET=replace-with-a-long-random-secret
SPOKEN_ENGLISH_JWT_ALGORITHM=HS256
SPOKEN_ENGLISH_JWT_ISSUER=spoken-english-ai
SPOKEN_ENGLISH_JWT_AUDIENCE=spoken-english-ai-api
SPOKEN_ENGLISH_ACCESS_TOKEN_LIFETIME_MINUTES=15
SPOKEN_ENGLISH_REFRESH_TOKEN_LIFETIME_DAYS=30
SPOKEN_ENGLISH_PASSWORD_MINIMUM_LENGTH=12
SPOKEN_ENGLISH_PASSWORD_MAXIMUM_BYTES=72
