SPOKEN_ENGLISH_APP_NAME=spoken-english-ai
SPOKEN_ENGLISH_APP_VERSION=0.1.0
SPOKEN_ENGLISH_ENVIRONMENT=development
SPOKEN_ENGLISH_DEBUG=false
SPOKEN_ENGLISH_DATABASE_URL=sqlite:///./spoken_english_ai.db
SPOKEN_ENGLISH_LLM_PROVIDER=disabled
SPOKEN_ENGLISH_SPEECH_TO_TEXT_PROVIDER=disabled
SPOKEN_ENGLISH_TEXT_TO_SPEECH_PROVIDER=disabled
SPOKEN_ENGLISH_AUTO_CREATE_TABLES=true
SPOKEN_ENGLISH_TEMPORARY_AUDIO_EXPIRATION_HOURS=24
SPOKEN_ENGLISH_JWT_SECRET=replace-with-a-long-random-secret
SPOKEN_ENGLISH_JWT_ACTIVE_KEY_ID=active-2026-01
SPOKEN_ENGLISH_JWT_VERIFICATION_KEYS_JSON={"active-2026-01":"replace-with-active-secret","previous-2025-12":"replace-with-previous-secret"}
SPOKEN_ENGLISH_JWT_ALGORITHM=HS256
SPOKEN_ENGLISH_JWT_ISSUER=spoken-english-ai
SPOKEN_ENGLISH_JWT_AUDIENCE=spoken-english-ai-api
SPOKEN_ENGLISH_ACCESS_TOKEN_LIFETIME_MINUTES=15
SPOKEN_ENGLISH_REFRESH_TOKEN_LIFETIME_DAYS=30
SPOKEN_ENGLISH_PASSWORD_MINIMUM_LENGTH=12
SPOKEN_ENGLISH_PASSWORD_MAXIMUM_BYTES=72
SPOKEN_ENGLISH_BUILD_IDENTIFIER=local
SPOKEN_ENGLISH_EXPOSE_DEVELOPMENT_METRICS=false
SPOKEN_ENGLISH_AUDIO_CLEANUP_BATCH_SIZE=100
SPOKEN_ENGLISH_PROVIDER_SANDBOX_ENABLED=false
SPOKEN_ENGLISH_PROVIDER_SANDBOX_DAILY_BUDGET_USD=10
SPOKEN_ENGLISH_PROVIDER_SANDBOX_MONTHLY_BUDGET_USD=150
SPOKEN_ENGLISH_PROVIDER_SANDBOX_PER_USER_BUDGET_USD=7.5
SPOKEN_ENGLISH_PROVIDER_SANDBOX_DAILY_REQUESTS=100
SPOKEN_ENGLISH_PROVIDER_SANDBOX_PER_USER_REQUESTS=10
SPOKEN_ENGLISH_PROVIDER_SANDBOX_TOKEN_LIMIT=4096
SPOKEN_ENGLISH_PROVIDER_SANDBOX_AUDIO_SECONDS_LIMIT=120
SPOKEN_ENGLISH_COMMERCIAL_MONTHLY_PRICE_INR=299
SPOKEN_ENGLISH_COMMERCIAL_YEARLY_PRICE_INR=2999
SPOKEN_ENGLISH_COMMERCIAL_TRIAL_DAYS=7
SPOKEN_ENGLISH_COMMERCIAL_FREE_DAILY_CONVERSATIONS=5
SPOKEN_ENGLISH_COMMERCIAL_FREE_DAILY_VOICE_MINUTES=5
SPOKEN_ENGLISH_COMMERCIAL_FREE_DAILY_GRAMMAR_CHECKS=5
SPOKEN_ENGLISH_COMMERCIAL_FREE_DAILY_PRONUNCIATION_CHECKS=3
SPOKEN_ENGLISH_COMMERCIAL_PREMIUM_FAIR_USE_DAILY_REQUESTS=200
SPOKEN_ENGLISH_COMMERCIAL_PREMIUM_VOICE_MINUTES=120
SPOKEN_ENGLISH_COMMERCIAL_MONTHLY_AI_COST_LIMIT_USD=20
SPOKEN_ENGLISH_COMMERCIAL_TRIAL_DAILY_REQUESTS=50
SPOKEN_ENGLISH_COMMERCIAL_MONTHLY_REQUEST_LIMIT=5000
SPOKEN_ENGLISH_COMMERCIAL_TOKEN_LIMIT=500000
SPOKEN_ENGLISH_COMMERCIAL_ADVERTISEMENTS_ENABLED=false
SPOKEN_ENGLISH_COMMERCIAL_PREMIUM_TUTORS_ENABLED=true
SPOKEN_ENGLISH_RAZORPAY_ENABLED=false
# SPOKEN_ENGLISH_RAZORPAY_WEBHOOK_SECRET is supplied only by an approved secret store.
# Provider keys are loaded only by separately approved adapters from named environment variables.
